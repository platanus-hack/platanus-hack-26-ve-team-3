{
  "name": "quorum",
  "private": true,
  "packageManager": "pnpm@10.18.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "pnpm --filter @quorum/web dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter @quorum/web test:e2e",
    "verify": "pnpm typecheck && pnpm lint && pnpm test && pnpm build"
  }
}
