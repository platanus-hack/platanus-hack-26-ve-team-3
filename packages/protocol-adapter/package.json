{
  "name": "@quorum/protocol-adapter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Adaptador del motor de votación Quórum (Plan A: Semaphore v4 + ledger hash-encadenado + ancla en Base Sepolia). No implementa primitivas criptográficas propias.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": { ".": "./src/index.ts" },
  "files": ["src", "artifacts", "scripts"],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "echo skip",
    "build": "echo skip",
    "test": "vitest run --pool=forks",
    "fixtures": "tsx scripts/make-fixtures.ts",
    "copy-artifacts": "bash scripts/copy-artifacts.sh"
  },
  "dependencies": {
    "@semaphore-protocol/core": "4.14.5",
    "viem": "2.57.11"
  },
  "devDependencies": {
    "@types/node": "^22",
    "tsx": "4.23.15",
    "typescript": "^5",
    "vitest": "^3.2.4"
  }
}
