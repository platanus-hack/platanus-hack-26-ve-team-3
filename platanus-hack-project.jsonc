{
  // Your project's name, as it will appear on the voting page.
  "project-name": "Quórum",

  // Short one-line summary of your project (in Spanish).
  "project-oneliner-spanish": "Votaciones para condominios, universidades y comunidades donde cualquiera puede verificar el resultado sin confiar en quien organiza.",

  // Brief description of your project (in Spanish).
  "project-description-spanish": "Quórum es una plataforma de votaciones internas (condominios, universidades, cooperativas, comunidades). La gente entra desde su teléfono con un QR, hace una prueba de vida con la cámara para evitar inscripciones dobles y vota en segundos. Cada boleta lleva una prueba criptográfica (Semaphore v4) de que la emitió alguien del padrón, sin revelar quién; el registro de boletas va encadenado con hashes y, al cerrar, el organizador ancla el resultado en Base Sepolia. Lo importante: un verificador independiente, que no toca la base de datos del organizador, recomputa el padrón, las pruebas, la unicidad de cada voto, la cadena, el recuento y el ancla, y señala con causa concreta cualquier manipulación. Lema: Trust the proof, not the organizer.",

  // Public URL where your project is deployed and running.
  // Must be a valid URL, for example: https://my-project.vercel.app
  // If your project is an app, put the download link here instead
  // (for example, a URL to download an APK).
  "deploy-url": "https://quorum-sefw.onrender.com"
}
