{
  "name": "@quorum/verifier",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Verificador independiente de Quórum: recomputa raíz, cadena, pruebas Semaphore, nullifiers, recuento y ancla a partir del paquete de auditoría público. No importa apps/web ni lee la base de datos del organizador.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": { ".": "./src/index.ts" },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "echo skip",
    "build": "echo skip",
    "test": "vitest run --pool=forks",
    "verify": "tsx src/cli.ts"
  },
  "dependencies": {
    "@quorum/contracts": "workspace:*",
    "@semaphore-protocol/core": "4.14.5",
    "viem": "2.57.11",
    "zod": "^4.1.8"
  },
  "devDependencies": {
    "@quorum/protocol-adapter": "workspace:*",
    "@types/node": "^22",
    "tsx": "4.23.15",
    "typescript": "^5",
    "vitest": "^3.2.4"
  }
}
