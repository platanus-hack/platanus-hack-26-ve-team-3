{
  "name": "@quorum/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:net": "vitest run --config vitest.net.config.ts",
    "test:e2e": "playwright test",
    "seed:demo": "tsx --tsconfig tsconfig.json scripts/seed-demo.ts",
    "test:e2e:real": "playwright test -c playwright.real.config.ts",
    "fixtures:lab": "tsx --tsconfig tsconfig.json scripts/make-lab-fixture.ts",
    "load:test": "tsx --tsconfig tsconfig.json scripts/load-test.ts"
  },
  "dependencies": {
    "@privy-io/react-auth": "^3.51.0",
    "@quorum/contracts": "workspace:*",
    "@quorum/notify": "workspace:*",
    "@quorum/protocol-adapter": "workspace:*",
    "@quorum/ui": "workspace:*",
    "@quorum/verifier": "workspace:*",
    "@quorum/wallet": "workspace:*",
    "@vladmandic/human": "^3.3.6",
    "ai": "^7.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jsqr": "1.4.0",
    "lucide-react": "^1.61.0",
    "next": "16.4.3",
    "permissionless": "^0.2.57",
    "qrcode": "1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.7.0",
    "uqr": "0.1.2",
    "viem": "^2.57.11",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@testing-library/dom": "10.4.0",
    "@testing-library/react": "16.3.0",
    "@types/node": "^20",
    "@types/qrcode": "1.5.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "jsdom": "26.1.0",
    "tailwindcss": "^4",
    "tsx": "4.23.15",
    "typescript": "^5",
    "vitest": "^3.2.4"
  }
}
