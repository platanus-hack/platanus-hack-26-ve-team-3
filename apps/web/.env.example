# Quórum — variables de entorno (sin valores; copiar a .env.local)
APP_URL=
DATA_DIR=
QUORUM_STORE=

# Invitaciones (dry-run | wame | kapso | meta). kapso/meta solo envían si INVITE_SEND_APPROVED=true
INVITE_CHANNEL=
INVITE_SEND_APPROVED=
KAPSO_API_KEY=
KAPSO_PHONE_NUMBER_ID=
KAPSO_TEMPLATE=
KAPSO_WEBHOOK_SECRET=
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=

# Wallet embebida / firma EIP-712
NEXT_PUBLIC_PRIVY_APP_ID=
PRIVY_APP_SECRET=
NEXT_PUBLIC_CHAIN_ID=
BASE_SEPOLIA_RPC=

# Layout generativo (AI Gateway). Sin clave: layout default por tipo
AI_GATEWAY_API_KEY=

# Prueba de vida (demo). FACE_KEY: hex de 64 chars; obligatoria en producción
FACE_THRESHOLD=
FACE_KEY=

# Contrato v1 (fase 2)
# Dedupe facial 1:N (similitud coseno; default 0.75)
FACE_DEDUPE_THRESHOLD=
# Ancla en Base Sepolia al cerrar: requiere ORGANIZER_PRIVATE_KEY + BASE_SEPOLIA_RPC. Sin ellas: deshabilitada (honesto)
# Solo servidor/scripts; clave de testnet con ETH de faucet. NUNCA en git
ORGANIZER_PRIVATE_KEY=
QUORUM_EAS_ENABLED=
QUORUM_EAS_SCHEMA_UID=
# Smart wallet gasless (ZeroDev Kernel, Base Sepolia). Sin project id: modo eoa-demo etiquetado. Ver docs/WALLETS.md
NEXT_PUBLIC_ZERODEV_PROJECT_ID=
# QuorumRegistry desplegado (scripts/deploy-registry.ts)
NEXT_PUBLIC_REGISTRY_ADDRESS=
# C2: enviar `cast` on-chain desde la wallet del votante enlaza wallet↔boleta. Dejar en false salvo decisión explícita
QUORUM_ONCHAIN_CAST=false
NEXT_PUBLIC_QUORUM_ONCHAIN_CAST=false
NEXT_PUBLIC_DEMO_ELECTION_ID=
# Sala abierta: entradas por minuto por IP en POST /api/rooms/:code/join (default 30; el wifi del evento comparte IP)
ROOM_JOIN_RATE_PER_MIN=
